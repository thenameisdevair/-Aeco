# Aeco Agent — environment variables
# Copy this file to .env and fill in your values.

# JSON-RPC endpoint (Celo mainnet or testnet)
RPC_URL=

# Agent wallet (holds AGENT_ROLE on SentimentFeed and HeartbeatOracle)
PRIVATE_KEY_AGENT=
AGENT_WALLET=

# Deployer wallet (used to submit ERC-8004 reputation feedback — must NOT be the agent wallet)
PRIVATE_KEY_DEPLOYER=

# Grok API key for LLM sentiment analysis
GROK_API_KEY=

# Deployed contract addresses
SENTIMENT_FEED_ADDRESS=
HEARTBEAT_ORACLE_ADDRESS=

# Optional
AGENT_VERSION=1.0.0
CELOSCAN_API_KEY=
THIRDWEB_SECRET_KEY=
