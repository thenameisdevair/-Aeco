{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true
  },
  "ts-node": {
    "extensionless": true,
    "transpileOnly": true
  },
  "include": ["agent/**/*"],
  "exclude": ["node_modules", "contracts"]
}